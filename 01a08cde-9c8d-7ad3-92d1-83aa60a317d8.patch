+export interface ClipKey {
+  t: number;
+  pose: Pose;
+  /** Hips offset from bind (metres). Defaults to [0, 0, 0]. */
+  root?: [number, number, number];
+  /** Easing of the transition INTO this key. Defaults to 'smooth'. */
+  ease?: EaseName;
