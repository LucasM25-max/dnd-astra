+function ease(name: EaseName, t: number): number {
+  switch (name) {
+    case 'linear':
+      return t;
+    case 'in':
+      return t * t * t;
+    case 'out':
+      return 1 - (1 - t) * (1 - t) * (1 - t);
+    case 'inout':
+      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
+    case 'smooth':
+    default:
+      return t * t * (3 - 2 * t);
+  }
